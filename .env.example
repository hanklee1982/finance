# Finance AI System Configuration - Example

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
BACKEND_PORT=3000
FRONTEND_PORT=80

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_ai
DB_USER=root
DB_PASSWORD=
DATABASE_URL=sqlite://./database.sqlite

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Payment Gateway Configuration
PAYMENT_API_KEY=your_payment_gateway_api_key
PAYMENT_SECRET_KEY=your_payment_gateway_secret_key

# AI Service Configuration
AI_API_KEY=your_ai_service_api_key
AI_MODEL=your_ai_model_name

# Volcengine Configuration
VOLCENGINE_API_KEY=your_volcengine_api_key
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=doubao-seed-2.0-lite

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Security Configuration
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/finance_ai.log

# GitHub Configuration
GITHUB_TOKEN=your_github_token
GITHUB_REPO=your_github_repo
GITHUB_OWNER=your_github_owner

# Server Configuration for Deployment
SERVER_HOST=your_server_ip
SERVER_PORT=22
SERVER_USER=root
SERVER_PASSWORD=your_server_password
SERVER_WORKDIR=/opt/finance-test

# Domain Configuration
DOMAIN_MAIN=dcool.com
DOMAIN_TEST=opnai.dcool.com
NGINX_SERVER_NAME=opnai.dcool.com